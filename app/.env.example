VITE_POCKETBASE_URL=http://127.0.0.1:8090
VITE_SITE_URL=http://127.0.0.1:5173
VITE_APP_ENV=development
VITE_USE_DEV_FIXTURES=false

# Local verification of the built web with npm start (PocketBase runs separately).
MONIKE_ENV=test
MONIKE_SITE_URL=http://127.0.0.1:3000
MONIKE_POCKETBASE_URL=http://127.0.0.1:8090
MONIKE_POCKETBASE_INTERNAL_URL=http://127.0.0.1:8090
MONIKE_TRUST_PROXY=false
PORT=3000

# Rosti production: put these values in the stack's Environment, not in Git.
# APP_ENV=production
# MONIKE_SITE_URL=https://monike.example
# MONIKE_PUBLIC_POCKETBASE_URL=https://monike.example
# MONIKE_SUPERUSER_IPS=203.0.113.10/32
# PB_ENCRYPTION_KEY=<exactly-32-random-characters>
# MONIKE_BACKUP_STORAGE=local
# Optional off-server S3 backups (including Cloudflare R2):
# MONIKE_BACKUP_STORAGE=s3
# MONIKE_S3_ENDPOINT=https://account.r2.cloudflarestorage.com
# MONIKE_S3_BUCKET=monike-backups
# MONIKE_S3_REGION=auto
# MONIKE_S3_ACCESS_KEY_ID=
# MONIKE_S3_SECRET_ACCESS_KEY=
