# Vlozit do .env editoru Stacku, ne do Git. Nahradit domeny a IP skutecnymi hodnotami.
APP_ENV=production
MONIKE_RELEASE=release-20260920
MONIKE_SITE_URL=https://monike.example
MONIKE_PUBLIC_POCKETBASE_URL=https://monike.example
MONIKE_SUPERUSER_IPS=203.0.113.10/32
# Nahodny 32znakovy klic; pri stehovani zachovat puvodni klic.
PB_ENCRYPTION_KEY=
MONIKE_HSTS_MAX_AGE=300
MONIKE_BACKUP_STORAGE=local
# Volitelne nezavisle S3 zalohy: zmenit STORAGE na s3 a vyplnit vsechny hodnoty.
MONIKE_S3_ENDPOINT=
MONIKE_S3_BUCKET=
MONIKE_S3_REGION=auto
MONIKE_S3_ACCESS_KEY_ID=
MONIKE_S3_SECRET_ACCESS_KEY=
