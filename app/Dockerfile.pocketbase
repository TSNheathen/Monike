# syntax=docker/dockerfile:1

ARG ALPINE_IMAGE=alpine:3.22.1@sha256:eafc1edb577d2e9b458664a15f23ea1c370214193226069eb22921169fc7e43f

FROM --platform=linux/amd64 ${ALPINE_IMAGE} AS pocketbase-download

ARG PB_VERSION=0.40.1
ARG PB_ARCHIVE_SHA256=0f3442d2e57b03b56fbff0d09289e4a30b4f561a44338c38d2dcd4a1a0cfa91e

RUN apk add --no-cache ca-certificates curl unzip \
    && curl --fail --silent --show-error --location \
      "https://github.com/pocketbase/pocketbase/releases/download/v${PB_VERSION}/pocketbase_${PB_VERSION}_linux_amd64.zip" \
      --output /tmp/pocketbase.zip \
    && echo "${PB_ARCHIVE_SHA256}  /tmp/pocketbase.zip" | sha256sum -c - \
    && unzip /tmp/pocketbase.zip pocketbase -d /out \
    && chmod 0555 /out/pocketbase

FROM --platform=linux/amd64 ${ALPINE_IMAGE}

RUN apk add --no-cache ca-certificates su-exec tzdata \
    && addgroup -S -g 10001 pocketbase \
    && adduser -S -D -H -u 10001 -G pocketbase pocketbase \
    && mkdir -p /pb/pb_data /pb/pb_hooks /pb/pb_migrations \
    && chown 10001:10001 /pb/pb_data \
    && chmod 0750 /pb/pb_data

WORKDIR /pb

COPY --from=pocketbase-download /out/pocketbase /pb/pocketbase
COPY pb_hooks/ /pb/pb_hooks/
COPY pb_migrations/ /pb/pb_migrations/
COPY public/assets/landing/card-*.png /pb/public/assets/landing/
COPY docker/pocketbase-entrypoint.sh /usr/local/bin/pocketbase-entrypoint

RUN sed -i 's/\r$//' /usr/local/bin/pocketbase-entrypoint \
    && chmod -R 0555 /pb/pb_hooks /pb/pb_migrations /pb/public \
    && chmod 0555 /pb/pocketbase /usr/local/bin/pocketbase-entrypoint

EXPOSE 8080
VOLUME ["/pb/pb_data"]

ENTRYPOINT ["/usr/local/bin/pocketbase-entrypoint"]
